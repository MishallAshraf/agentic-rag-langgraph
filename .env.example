# Copy this file to .env and fill in your key. Never share or commit .env.
# Create a key at https://openrouter.ai/keys
OPENROUTER_API_KEY=

# Any model id from https://openrouter.ai/models (optional)
OPENROUTER_MODEL=anthropic/claude-haiku-5.5
# Step 9: tried in order if the main model fails; "none" turns fallback off (optional)
OPENROUTER_FALLBACK_MODELS=openai/gpt-4o-mini

# Step 8 (optional): the evaluation judge, and Langfuse for tracing and experiments.
# Keys from a project at https://cloud.langfuse.com (Settings -> API keys).
EVAL_JUDGE_MODEL=anthropic/claude-sonnet-5.5
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_HOST=https://cloud.langfuse.com

# Step 11 (optional): the API server (python api.py).
API_PORT=8000
API_RATE_LIMIT=10
API_TURN_TIMEOUT=120
API_CORS_ORIGINS=http://localhost:5173
# Step 13 (optional): users, quotas and the session cookie.
# Lampus Phase 1, Step 3: users, sessions, quotas and the audit log live in Postgres.
# The default matches docker-compose.yml (docker compose up -d db).
DATABASE_URL=postgresql://lampus:lampus@localhost:5432/lampus
# Redis: rate limits, conversation locks and the search cache, shared by every API copy
REDIS_URL=redis://localhost:6379/0
# 0 when bot builds run in separate workers (python -m engine.worker)
API_RUN_WORKER=1
# a worker's build is taken over after this long without a sign of life
QUEUE_CLAIM_IDLE_MS=60000
# Step 9: searches read from this Postgres replica when set (empty: the primary)
DATABASE_READ_URL=
# the proxy addresses whose X-Forwarded-For is believed (nginx on the same machine)
FORWARDED_ALLOW_IPS=127.0.0.1
# a conversation lock lasts this many seconds unless its turn renews it
API_LOCK_TTL=15
# threads for the agents' tools; 0 = Python's default (cores + 4)
API_TOOL_THREADS=0
# 0 turns the shared search cache off (load tests that must reach the database)
SEARCH_CACHE=1
QUOTA_TURNS_PER_DAY=100
QUOTA_TOKENS_PER_DAY=300000
# true once the API is served over HTTPS
API_COOKIE_SECURE=false
